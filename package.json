{
  "name": "virtual-agent-office",
  "productName": "Virtual Agent Office",
  "version": "1.0.0",
  "description": "Oficina virtual pixel-art para agentes de IA - motor Claude Office con puente para n8n",
  "author": "Polyrafia",
  "license": "MIT",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently \"node server/index.js\" \"vite\"",
    "build": "tsc && vite build",
    "build:webview": "vite build",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "token": "node server/token.js",
    "rotate-token": "node scripts/rotate-token.mjs",
    "open": "node scripts/open-office.mjs",
    "check-assets": "node scripts/check-assets.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "^7.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "vitest": "^3.2.7"
  }
}
